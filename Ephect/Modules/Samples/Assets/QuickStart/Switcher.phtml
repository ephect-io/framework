<?php

namespace QuickStart;

use function Ephect\Modules\Routing\Forms\Router;
use function Ephect\Modules\Routing\Forms\Route;

function Switcher(): string
{
    return (<<< HTML
    <Router>
        <Route method='GET' rule='/' redirect='Home' />
        <Route method='GET' rule='/hello/(name)/(lname)' redirect='Hello' />
        <Route method='GET' rule='/world\?name=(.*)&lname=(.*)' redirect='World' />
        <Route method='GET' rule='/world/?' redirect='World' />
        <Route method='GET' rule='/matriochka/(devotchka)' redirect='Matriochka0' />
        <Route method='GET' rule='/matriochka/?' redirect='Matriochka0' />
        <Route method='GET' rule='/info/?' redirect='Info' />
        <Route method='GET' rule='/callback' redirect='Callback' />
        <Route method='POST' rule='/response' redirect='Response' />
    </Router>
    HTML);
}
