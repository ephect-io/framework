<?php

namespace  Ephect\Modules\Routing\Forms;

use function Ephect\Modules\Routing\Hooks\useRoutes;

function RoutesMenu(): string
{
    $routes = useRoutes();
    return (<<< HTML
        <ul>
        @for %routes as %route do
            @op %props = (object)%route;
            <li ><a href="{{ props->url }}">{{ props->caption }}</a></li>
        @done
        </ul>
    HTML);
}
